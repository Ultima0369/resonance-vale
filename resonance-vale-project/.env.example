# Resonance Vale Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here

# Paperclip Integration
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_API_KEY=your-paperclip-api-key
PAPERCLIP_COMPANY_ID=7dcdefdc-723b-48f1-ba0f-d3c03dc34d4d
PAPERCLIP_AGENT_ID=281ab453-cf1d-4b98-bff6-3f063c7e6ea0

# OpenClaw Integration
OPENCLAW_WORKSPACE_PATH=C:\Users\lgdln\.openclaw\workspace
OPENCLAW_SKILLS_PATH=C:\Users\lgdln\.openclaw\workspace\skills

# AI API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
CODEX_API_KEY=your-codex-api-key

# Database (if using)
DATABASE_URL=postgresql://username:password@localhost:5432/resonance_vale
REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_DSN=your-sentry-dsn-if-using
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key-if-using

# External Services
RESEARCH_DB_API_KEY=your-research-database-api-key
ACADEMIC_API_KEY=your-academic-api-key
WEB_SEARCH_API_KEY=your-web-search-api-key

# Email/SMTP (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
NOTIFICATION_EMAIL=notifications@yourdomain.com

# File Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,json,csv

# Rate Limiting
RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3100
CORS_CREDENTIALS=true

# Cache
CACHE_TTL=3600000  # 1 hour in milliseconds
CACHE_MAX_SIZE=100

# Feature Flags
FEATURE_AUTONOMOUS_RESEARCH=true
FEATURE_PRISM_PROTOCOL=true
FEATURE_FIRE_SIDE_DIALOGUE=true
FEATURE_REAL_TIME_MONITORING=true

# Development
DEBUG=true
DEV_MODE=true
SKIP_AUTH=false  # Only for development!